{
  "description": "What the app reads of the server api (checked by AppApiContractTest in projectforge-application). Per contract: the Dart files and the endpoints the app calls, each with the controller, the class of its answer (list: true for a list of it) and the fields the app reads of it (paths below the answer class, [] steps into a list). An endpoint without answer is only checked for existing. optionalReads are fields the app reads defensively (a fallback exists): they are listed so the Dart files stay covered, but the server may not have them. Every ['key'] a listed Dart file reads must be named here (in reads, optionalReads or ignoreKeys), and everything in reads must exist on the server. Removing or renaming a field named here breaks the published app: see dev-docs/flutter-client.md, 'Changing an api the app uses'.",
  "contracts": [
    {
      "name": "Digital business cards",
      "dartFiles": [
        "lib/features/business_cards/business_card.dart",
        "lib/features/business_cards/business_card_qr_screen.dart",
        "lib/features/business_cards/business_cards_repository.dart",
        "lib/features/business_cards/business_cards_screen.dart"
      ],
      "endpoints": [
        {
          "call": "GET /rs/myBusinessCards",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest",
          "answer": "org.projectforge.rest.businesscard.BusinessCardRest$InitData",
          "reads": [
            "cards[].card.id",
            "cards[].card.cardName",
            "cards[].card.addressId",
            "cards[].card.includePhoto",
            "cards[].card.title",
            "cards[].card.firstName",
            "cards[].card.lastName",
            "cards[].card.organization",
            "cards[].preview.qrCodeUrl",
            "cards[].preview.vCardLength",
            "cards[].preview.withPhoto",
            "cards[].preview.photoAllowed",
            "suggestion",
            "maxCards",
            "walletConfigured"
          ]
        },
        {
          "call": "GET /rs/myBusinessCards/vcf",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest"
        },
        {
          "call": "GET /rs/myBusinessCards/pkpass",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest"
        }
      ]
    },
    {
