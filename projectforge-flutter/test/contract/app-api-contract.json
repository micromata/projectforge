        "lib/core/status/user_status_repository.dart"
      ],
      "endpoints": [
        {
          "call": "GET /rs/userStatus",
          "controller": "org.projectforge.rest.UserStatusRest",
          "answer": "org.projectforge.rest.UserStatusRest$Result",
          "reads": [
            "chatUnread",
            "disabledFeatures",
            "notifications.openCount",
            "notifications.maxSeverity",
            "notifications.latestId",
            "theme",
            "systemData.version",
            "systemData.minAppVersion"
          ]
        }
      ]
