        "lib/features/timesheets/timesheet.dart",
        "lib/features/timesheets/timesheets_controller.dart",
        "lib/features/timesheets/timesheets_repository.dart",
        "lib/features/timesheets/timesheets_screen.dart"
      ],
      "ignoreKeys": [
        "user",
        "start",
        "what",
        "time",
        "general"
      ],
      "endpoints": [
        {
          "call": "GET /rs/timesheet/appList",
          "controller": "org.projectforge.rest.TimesheetEntityRest",
          "answer": "org.projectforge.rest.TimesheetEntityRest$AppTimesheetList",
          "reads": [
            "timesheets[].id",
            "timesheets[].startTime",
            "timesheets[].stopTime",
            "timesheets[].acceptance",
            "timesheets[].task.id",
            "timesheets[].task.title",
            "timesheets[].task.path",
            "timesheets[].kost2.id",
            "timesheets[].kost2.description",
            "timesheets[].description",
            "timesheets[].location",
            "timesheets[].reference",
            "timesheets[].tag",
            "tags",
            "timesheets[].kost2.formattedNumber"
          ],
          "optionalReads": [
            "timesheets[].task.displayName",
            "timesheets[].task.path[].title",
            "timesheets[].kost2.title",
            "timesheets[].kost2.displayName"
          ]
        },
        {
          "call": "GET /rs/timesheet/{id}",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "PUT /rs/timesheet/insert",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "PUT /rs/timesheet/update",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "DELETE /rs/timesheet/markAsDeleted",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
