          "call": "PUT /rs/timesheet/undelete",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "GET /rs/timesheet/recentList",
          "controller": "org.projectforge.rest.TimesheetEntityRest",
          "answer": "org.projectforge.rest.TimesheetEntityRest$RecentTimesheets",
          "reads": [
            "timesheets[].task",
            "timesheets[].kost2",
            "timesheets[].description",
            "timesheets[].location",
            "timesheets[].reference",
            "timesheets[].tag"
          ]
        },
        {
          "call": "GET /rs/timesheet/favorites/list",
          "controller": "org.projectforge.rest.TimesheetFavoritesRest",
          "answer": "org.projectforge.business.timesheet.TimesheetFavorite",
          "list": true,
          "reads": [
            "id",
            "name",
            "taskId",
            "cost2Id",
            "description",
            "location",
            "reference",
            "tag"
          ]
        },
        {
          "call": "POST /rs/timesheet/favorites/create",
          "controller": "org.projectforge.rest.TimesheetFavoritesRest"
        },
        {
          "call": "POST /rs/timesheet/favorites/delete",
          "controller": "org.projectforge.rest.TimesheetFavoritesRest"
        },
        {
          "call": "GET /rs/task/tree/autosearch",
          "controller": "org.projectforge.rest.task.TaskServicesRest",
          "answer": "org.projectforge.rest.core.AbstractEntityRest$DisplayObject",
          "list": true,
          "reads": [
            "id",
            "displayName"
          ]
        },
        {
          "call": "GET /rs/task/recent/list",
          "controller": "org.projectforge.rest.task.TaskServicesRest",
          "answer": "org.projectforge.rest.core.AbstractEntityRest$DisplayObject",
          "list": true,
          "reads": [
            "id",
            "displayName"
          ]
        },
        {
          "call": "GET /rs/task/tree/children",
          "controller": "org.projectforge.rest.task.TaskServicesRest",
          "answer": "org.projectforge.rest.task.TaskServicesRest$TaskChild",
          "list": true,
          "reads": [
            "id",
            "title",
            "hasChildren",
            "bookable"
          ]
        },
        {
          "call": "GET /rs/task/info/{id}",
          "controller": "org.projectforge.rest.task.TaskServicesRest",
          "answer": "org.projectforge.rest.task.TaskServicesRest$Task",
          "reads": [
            "kost2List[].id",
            "kost2List[].title",
            "path[].id",
            "path[].title"
