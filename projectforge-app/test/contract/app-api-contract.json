{
  "description": "The endpoints the app (projectforge-app) calls, checked by AppTsApiContractTest in projectforge-application. The fields it reads and sends are the TypeScript interfaces of projectforge-shared/src/rs (each with @server or @request and its Kotlin class), checked by the same test. Removing or renaming any of them breaks the published app: see dev-docs/app-api-deprecations.md.",
  "contracts": [
    {
      "name": "App login and session",
      "endpoints": [
        {
          "call": "POST /rsPublic/appAuth/token",
          "controller": "org.projectforge.rest.app.AppAuthPublicRest"
        },
        {
          "call": "GET /rsPublic/systemStatus",
          "controller": "org.projectforge.rest.pub.SystemStatusRest"
        },
        {
          "call": "POST /rs/appAuth/logout",
          "controller": "org.projectforge.rest.app.AppAuthRest"
        },
        {
          "call": "POST /rs/appAuth/webSession",
          "controller": "org.projectforge.rest.app.AppAuthRest"
        },
        {
          "call": "POST /rs/appAuth/pushToken",
          "controller": "org.projectforge.rest.app.AppAuthRest"
        },
        {
          "call": "POST /rs/appAuth/pushToken/remove",
          "controller": "org.projectforge.rest.app.AppAuthRest"
        }
      ]
    },
    {
      "name": "User status",
      "endpoints": [
        {
          "call": "GET /rs/userStatus",
          "controller": "org.projectforge.rest.UserStatusRest"
        },
        {
          "call": "GET /rs/uiSettings/theme",
          "controller": "org.projectforge.rest.UISettingsRest"
        },
        {
          "call": "POST /rs/uiSettings/theme",
          "controller": "org.projectforge.rest.UISettingsRest"
        }
      ]
    },
    {
      "name": "Business cards",
      "endpoints": [
        {
          "call": "GET /rs/myBusinessCards",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest"
        },
        {
          "call": "GET /rs/myBusinessCards/vcf",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest"
        },
        {
          "call": "GET /rs/myBusinessCards/pkpass",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest"
        },
        {
          "call": "GET /rs/myBusinessCards/photo",
          "controller": "org.projectforge.rest.businesscard.BusinessCardRest"
        }
      ]
    },
    {
      "name": "Notifications",
      "endpoints": [
        {
          "call": "GET /rs/notification/my",
          "controller": "org.projectforge.rest.notification.NotificationRest"
        },
        {
          "call": "GET /rs/notification/my/archived",
          "controller": "org.projectforge.rest.notification.NotificationRest"
        },
        {
          "call": "POST /rs/notification/{id}/acknowledge",
          "controller": "org.projectforge.rest.notification.NotificationRest"
        },
        {
          "call": "POST /rs/notification/{id}/done",
          "controller": "org.projectforge.rest.notification.NotificationRest"
        }
      ]
    },
    {
      "name": "Addresses",
      "endpoints": [
        {
          "call": "GET /rs/address/appList",
          "controller": "org.projectforge.rest.AddressEntityRest"
        },
        {
          "call": "GET /rs/address/image/{id}",
          "controller": "org.projectforge.rest.AddressImageServicesRest"
        },
        {
          "call": "GET /rs/address/imagePreview/{id}",
          "controller": "org.projectforge.rest.AddressImageServicesRest"
        },
        {
          "call": "GET /rs/address/exportVCard/{id}",
          "controller": "org.projectforge.rest.AddressServicesRest"
        }
      ]
    },
    {
      "name": "Time sheets",
      "endpoints": [
        {
          "call": "GET /rs/timesheet/appList",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "GET /rs/timesheet/{id}",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "PUT /rs/timesheet/insert",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "PUT /rs/timesheet/update",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "DELETE /rs/timesheet/markAsDeleted",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "PUT /rs/timesheet/undelete",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "GET /rs/timesheet/recentList",
          "controller": "org.projectforge.rest.TimesheetEntityRest"
        },
        {
          "call": "GET /rs/timesheet/favorites/list",
          "controller": "org.projectforge.rest.TimesheetFavoritesRest"
        },
        {
          "call": "POST /rs/timesheet/favorites/create",
          "controller": "org.projectforge.rest.TimesheetFavoritesRest"
        },
        {
          "call": "POST /rs/timesheet/favorites/delete",
          "controller": "org.projectforge.rest.TimesheetFavoritesRest"
        },
        {
          "call": "GET /rs/task/tree/autosearch",
          "controller": "org.projectforge.rest.task.TaskServicesRest"
        },
        {
          "call": "GET /rs/task/recent/list",
          "controller": "org.projectforge.rest.task.TaskServicesRest"
        },
        {
          "call": "GET /rs/task/tree/children",
          "controller": "org.projectforge.rest.task.TaskServicesRest"
        },
        {
          "call": "GET /rs/task/info/{id}",
          "controller": "org.projectforge.rest.task.TaskServicesRest"
        }
      ]
    },
    {
      "name": "Menu",
      "endpoints": [
        {
          "call": "GET /rs/menu",
          "controller": "org.projectforge.rest.MenuRest"
        },
        {
          "call": "POST /rs/menu/recent",
          "controller": "org.projectforge.rest.MenuRest"
        }
      ]
    }
  ]
}
